# 식품안전나라에서 발급한 인증키. I0030 활용신청도 필요합니다.
# 공공데이터포털의 serviceKey와 다릅니다. 키는 GitHub/채팅에 올리지 마세요.
FOOD_API_KEY=

# 기본값은 HTTPS입니다. HTTPS 실패 시 HTTP로 자동 전환하지 않습니다.
FOOD_API_BASE_URL=https://openapi.foodsafetykorea.go.kr/api
FOOD_API_TIMEOUT=20
FOOD_API_INTERVAL=1.0
# 한 번 실행할 때 실제 HTTP 요청의 최대 횟수. 캐시 적중은 제외.
FOOD_API_MAX_REQUESTS=80

# API 검색 결과가 많아도 최대 300개까지만 수집하고 '검토 필요'로 표시합니다.
FOOD_API_PAGE_SIZE=100
FOOD_API_MAX_PAGES=3
